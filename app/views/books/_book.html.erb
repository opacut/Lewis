<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= book.author %>
  </div>

  <strong>Tags:</strong>
  <div>
    <% book.tags.each do |tag| %>
      <span>
        <%= tag.name %>
      </span>
    <% end %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= book.location %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= book.description %>
  </div>

  <div>
    <strong>Image:</strong>
    <%=image_tag book.image.variant(resize_to_limit: [200, 200]) if book.image.attached? %>
  </div>

</div>
